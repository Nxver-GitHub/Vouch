# Vouch — environment template
#
# Copy to .env.local and fill in. Never commit .env.local.
#   cp .env.example .env.local
#
# NOTE: wrangler reads local secrets from `.dev.vars`, not `.env.local`.
# A symlink keeps them in sync:  ln -sf .env.local .dev.vars
# For production:                wrangler secret put <NAME>

# ─── Anthropic ────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys.  Redeem the $50 hackathon credit at kickoff.
# Web search is enabled org-wide by default; a disabled org returns 400.
ANTHROPIC_API_KEY=

# ─── Google Places (New) ──────────────────────────────────────────────────────
# console.cloud.google.com → enable "Places API (New)" + billing.
# Key restriction MUST be "None" or API-restricted. An HTTP-referrer or IP
# restriction will 403 from a Worker — Workers have no stable egress IP.
GOOGLE_PLACES_API_KEY=

# ─── Stripe (TEST MODE) ───────────────────────────────────────────────────────
# dashboard.stripe.com → test mode → Developers → API keys.
# Account verified for this build: acct_1U8tkMQ8yrJTwMzR (livemode: false)
STRIPE_SECRET_KEY=
# From the webhook endpoint you register on the deployed Worker.
# Verification: signed_payload = `${timestamp}.${rawBody}` (PERIOD),
# and test mode also sends a FAKE v0 signature — match on v1 only.
STRIPE_WEBHOOK_SECRET=

# ─── Slack ────────────────────────────────────────────────────────────────────
# api.slack.com/apps → OAuth & Permissions → Bot User OAuth Token (xoxb-...).
# Scopes required: chat:write, chat:write.customize, chat:write.public
# chat:write.customize is what lets each agent post under its own name/icon.
# Socket Mode MUST be OFF or interactivity never reaches the Request URL.
SLACK_BOT_TOKEN=
# Basic Information → App Credentials → Signing Secret.
# Verification: base string = `v0:${timestamp}:${rawBody}` (COLONS), 5-min window.
SLACK_SIGNING_SECRET=
SLACK_OPS_CHANNEL=#ops

# ─── Linear ───────────────────────────────────────────────────────────────────
# linear.app → Settings → API → Personal API key.
# Header is `Authorization: <key>` with NO "Bearer" prefix.
# GraphQL returns HTTP 200 on partial failure — always check the errors array.
LINEAR_API_KEY=
LINEAR_TEAM_ID=a1ec0397-3b49-4835-adcd-18416b39d2d5
# Resolve these once from list_issue_statuses and hardcode them.
# Never look them up live during the demo.
LINEAR_STATE_AUDITED=
LINEAR_STATE_DEPLOYED=
LINEAR_STATE_OFFERED=
LINEAR_STATE_PAID=

# ─── Resend ───────────────────────────────────────────────────────────────────
# resend.com → API Keys. A VERIFIED DOMAIN IS REQUIRED.
# Add usevouch.dev, add the DNS records, do NOT proxy the CNAME (orange cloud
# breaks verification). Verifies in ~15 minutes.
RESEND_API_KEY=
RESEND_FROM=vouch@usevouch.dev
# Where the "owner" email lands during the demo — your own inbox.
DEMO_OWNER_EMAIL=

# ─── Brainbase ────────────────────────────────────────────────────────────────
# app.brainbaselabs.com → API key. Self-serve, no waitlist.
# POST /v2/threads creates AND runs an agent inline.
BRAINBASE_API_KEY=

# ─── Cloudflare ───────────────────────────────────────────────────────────────
# Only needed for API calls outside wrangler; wrangler uses its own OAuth login.
CLOUDFLARE_ACCOUNT_ID=d96ce9856fdbecc7de69d79264755e8b

# ─── App config ───────────────────────────────────────────────────────────────
# Zone is live: wildcard DNS + Universal SSL verified on arbitrary slugs.
# Universal SSL covers ONE label only — never go two levels deep.
PUBLIC_BASE_DOMAIN=usevouch.dev
# Hard spend cap per run, enforced by the Orchestrator.
RUN_BUDGET_USD=2.00
# Max tool calls per agent, to stop runaway loops.
AGENT_STEP_LIMIT=10
